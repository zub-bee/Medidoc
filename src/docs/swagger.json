{
  "openapi": "3.0.0",
  "info": {
    "title": "Medidoc API",
    "version": "1.0.0",
    "description": "OpenAPI spec generated from Medidoc Zod validators and route registry."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    }
  ],
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "statusCode": {
            "type": "integer"
          },
          "data": {
            "nullable": true
          },
          "errors": {
            "nullable": true
          }
        },
        "required": [
          "success",
          "message",
          "statusCode"
        ]
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "uptime": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "timestamp",
          "uptime"
        ]
      },
      "DetailedHealthData": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HealthData"
          },
          {
            "type": "object",
            "properties": {
              "environment": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "memory": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "number"
                  },
                  "total": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "used",
                  "total",
                  "unit"
                ]
              },
              "cpu": {
                "type": "object",
                "properties": {
                  "usage": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "usage"
                ]
              }
            },
            "required": [
              "environment",
              "version",
              "memory",
              "cpu"
            ]
          }
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "confirmPassword"
        ]
      },
      "RegisterPatientRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "nin": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11
          },
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          },
          "confirm_password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          },
          "gender": {
            "type": "string",
            "enum": [
              "female",
              "male"
            ]
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "dob",
          "phone",
          "nin",
          "email",
          "password",
          "confirm_password",
          "gender"
        ]
      },
      "RegisterOrganizationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cac_number": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          }
        },
        "required": [
          "name",
          "cac_number",
          "email",
          "password"
        ]
      },
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "platform",
              "provider",
              "practitioner",
              "patient"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "role",
          "code"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "platform",
              "provider",
              "practitioner",
              "patient"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "avatar": {
            "type": "string"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyResetOtpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "platform",
              "provider",
              "practitioner",
              "patient"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "role",
          "code"
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "format": "email"
          },
          "new_password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "new_password"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "old_password": {
            "type": "string",
            "minLength": 1
          },
          "new_password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          }
        },
        "required": [
          "old_password",
          "new_password"
        ]
      },
      "RequestDeleteAccountRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "password"
        ]
      },
      "DeleteAccountRequest": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "soft",
              "hard"
            ],
            "default": "soft"
          }
        },
        "required": [
          "user_id"
        ]
      }
    },
    "parameters": {},
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter an access token"
      },
      "accessTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "Access token stored in the accessToken cookie"
      },
      "refreshTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken",
        "description": "Refresh token stored in the refreshToken cookie"
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Basic health check",
        "responses": {
          "200": {
            "description": "Service health status",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/HealthData"
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/detailed": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Detailed health check",
        "responses": {
          "200": {
            "description": "Detailed service health status",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/DetailedHealthData"
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signup succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register/patient": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a patient account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPatientRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patient registration succeeded",
